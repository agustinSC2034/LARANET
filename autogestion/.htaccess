Options -Indexes
DirectoryIndex index.html
# Set PHP 8.2+ in the hosting panel; no provider-specific handler is assumed.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://web.central.chat; worker-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src https://web.central.chat; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
</IfModule>
<FilesMatch "^(?!api\.php$).+\.(?:php|cjs|json|md|ini|log|env|yml)$">
  Require all denied
</FilesMatch>
